rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Gambar artikel boleh dibaca publik, hanya admin yang bisa upload/ubah.
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Folder lain tertutup untuk publik.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
